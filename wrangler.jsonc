// Cloudflare Workers config: serves this repository as a static site on warujie.jp.
// Cloudflare rebuilds and redeploys warujie.jp automatically on every push to main.
// Pushes to any other branch (e.g. "staging") build a separate test site instead:
//   https://<branch>-warujie.<subdomain>.workers.dev  (not indexed by search engines)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "warujie",
  "compatibility_date": "2026-10-01",
  // only the HTML pages, the card database and the Rakuten Books list (/shop/rakuten)
  // run through worker.js (see there);
  // every other file is served straight from the static assets
  "main": "worker.js",
  // before each deploy: the card database brotli-compressed (ja_cards.json.br)
  "build": { "command": "node tools/brotli_db.mjs" },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/preview", "/preview.html", "/preview/", "/ja_cards.json", "/shop/rakuten"]
  },
  // settings for the branch test sites; empty = same as production
  "previews": {}
}
